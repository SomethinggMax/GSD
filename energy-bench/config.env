# Experiment configuration. Sourced by all scripts. Keep this file in git: it is part of the record.

# --- Calibrated in pilot P2 (scripts/pilot.sh p2) -------------------------------------------
# Iterations of the CPU phase so that one task takes ~1 ms at 3 GHz. C uses the same loop as A.
ITERS_A=650000          # PLACEHOLDER: replace with the value from p2
ITERS_B=5500            # PLACEHOLDER: replace with the value from p2

# --- Design (report section 5) ---------------------------------------------------------------
TASKS=20000             # tasks per measured run
CORES=8                 # i7-9700: 8 cores, no hyper-threading
TCPU_NS=1000000         # nominal t_cpu; t_block = TCPU_NS * b / (1 - b)
SEED=20261008           # shuffle seed for the launch order (recorded in every plan)
LAUNCHES=10             # JVM launches per configuration
REPS=10                 # repetitions per launch
WARMUP=7                # first WARMUP repetitions are warm-up (still written, flagged is_warmup=1)

# --- Procedure (report section 6.4) ----------------------------------------------------------
PAUSE_SEC=10            # pause between launches
LAUNCH_TIMEOUT_SEC=3600 # a launch that takes longer is killed and logged as a time-out
IDLE_REPEATS=5          # idle power: number of windows at the start/end of a run
IDLE_SEC=60             # idle power: length of one window
IDLE_EVERY_SEC=21600    # extra idle measurement during long runs (every 6 h); 0 = off

# --- Runtime ---------------------------------------------------------------------------------
JAVA=java
JVM_FLAGS="-XX:+UseG1GC -Xms2g -Xmx2g -XX:+AlwaysPreTouch"
SERVER_JVM_FLAGS="-Xms256m -Xmx256m"
PORT=7777               # echo server for benchmark C (127.0.0.1 only)
RAPL_ROOT=/sys/class/powercap

# --- Expected environment (checked by scripts/precheck.sh) -----------------------------------
EXPECTED_JAVA="25.0"    # substring of `java -version`; empty = do not check
EXPECTED_GOVERNOR=powersave
